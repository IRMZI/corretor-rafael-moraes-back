# ---------------------------------------------------------------
# Servidor
# ---------------------------------------------------------------
PORT=3000
NODE_ENV=development

# ---------------------------------------------------------------
# Banco de dados (PostgreSQL)
# Use DATABASE_URL OU as variaveis PG* separadas.
# ---------------------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/corretor_leads
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=postgres
# PGDATABASE=corretor_leads

# Exigir SSL na conexao (true em provedores gerenciados: Neon, Supabase, RDS...)
DATABASE_SSL=false

# Rodar as migrations automaticamente ao subir o servidor
RUN_MIGRATIONS_ON_START=true

# ---------------------------------------------------------------
# CORS: dominios da landing page autorizados a enviar leads.
# Separe por virgula. Use * apenas em desenvolvimento.
# ---------------------------------------------------------------
CORS_ORIGINS=http://localhost:5500,https://seudominio.com.br

# ---------------------------------------------------------------
# Chave para consultar os leads (rotas administrativas).
# Envie no header: x-api-key: <valor>
# Gere uma com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ---------------------------------------------------------------
ADMIN_API_KEY=troque-esta-chave

# ---------------------------------------------------------------
# Anti-spam / rate limit do POST /api/leads
# ---------------------------------------------------------------
RATE_LIMIT_WINDOW_MINUTES=10
RATE_LIMIT_MAX=20

# Janela (minutos) para tratar um reenvio do mesmo WhatsApp como duplicado
DEDUPE_WINDOW_MINUTES=10

# Confiar no header X-Forwarded-For (1 = atras de 1 proxy/load balancer)
TRUST_PROXY=1

# ---------------------------------------------------------------
# Painel administrativo (/admin)
# ---------------------------------------------------------------
ADMIN_EMAIL=dev@pushagencia.com.br
ADMIN_PASSWORD=123321

# Segredo que assina o cookie de sessao do painel.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=troque-este-segredo

# Horas ate a sessao do painel expirar
SESSION_HOURS=12

# ---------------------------------------------------------------
# Evento de venda (disparado ao marcar a tag "vendido" no painel).
# Deixe em branco para apenas registrar a venda, sem enviar para fora.
# ---------------------------------------------------------------
# Meta (Facebook/Instagram) - API de Conversoes
META_PIXEL_ID=
META_ACCESS_TOKEN=
# META_TEST_EVENT_CODE=TEST12345

# Google Analytics 4 - Measurement Protocol
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
